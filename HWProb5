tickets = int(input("Enter the number of tickets: "))
  
if tickets >= 25:
 price = 50.00
elif tickets >= 10:
 price = 60.00
elif tickets >= 5:
 price = 70.00
else:
 price = 75.00

total_cost = tickets * price

print(f"Number of Tickets: {tickets}")
print(f"Price Per Ticket: ${price:.2f}")
print(f"Total Cost: ${total_cost:.2f}")
